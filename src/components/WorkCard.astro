---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { title, summary, tags, cover } = entry.data;
const href = `/work/${entry.id}`;

// Distinct muted placeholder hues so multiple cards look intentional
const placeholders = ['#d6d3cc', '#c9cdd4', '#cdd4cc'];
const bg = placeholders[index % placeholders.length];
---

<a href={href} class="group block" aria-label={`View project: ${title}`}>
  <div class="border-line relative w-full overflow-hidden rounded-sm border" style="aspect-ratio: 16/9;">
    {
      cover ? (
        <Image
          src={cover}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
          widths={[800, 1200, 1600]}
          sizes="(max-width: 768px) 100vw, 768px"
        />
      ) : (
        <div class="h-full w-full" style={`background-color: ${bg};`} />
      )
    }

  </div>

  <p class="font-display text-ink group-hover:text-signal mt-3 text-lg transition-colors">{title}</p>
</a>
