---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE, EXPERIENCE } from '@/site.config';
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <div class="prose prose-sm sm:prose-base mt-2 max-w-xl">
      <p>
        I'm a Lead Designer at Overjet, an AI dental company, where I joined as the first designer
        and built the design team. Before that I was Design Director at Carelon AI, and I built
        products, services and various design systems at Cisco, Webex and Acano.
      </p>
      <p>
        When I ran my own studio, I did the work myself again: research, design, prototyping,
        delivery. I learned Figma and the tools I had missed as a manager, and I got an early seat
        at how AI changes the job. I lead when a team needs it and make when the work needs hands.
      </p>
      <p>
        AI doesn't decide what's worth building, what an error message should say, or whether a rep
        on a live call can find the answer. My best days are spent with people and AI, finding a
        fast, elegant answer to a customer's problem.
      </p>
      <p>Tools change. Building things people can use hasn't.</p>
    </div>

    <div class="mt-14">
      <div class="mb-6 flex items-center justify-between">
        <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Experience</p>
        <a
          href="/resume.pdf"
          download
          class="border-line text-ink-soft hover:border-signal hover:text-signal flex items-center gap-1.5 rounded-full border px-3 py-1.5 font-mono text-xs transition-colors"
        >
          Download ↓
        </a>
      </div>

      <ul class="space-y-10">
        {
          EXPERIENCE.map((entry) => (
            <li class="grid gap-1 sm:grid-cols-[10rem_1fr] sm:gap-6">
              <div class="pt-0.5">
                <p class="text-ink-soft font-mono text-xs">
                  {entry.start} — {entry.end}
                </p>
                <p class="text-signal mt-0.5 font-mono text-xs">{entry.company}</p>
              </div>
              <div>
                <p class="text-ink font-medium">{entry.role}</p>
                <p class="text-ink-soft mt-1.5 text-sm leading-relaxed">{entry.description}</p>
                {entry.work.length > 0 && (
                  <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
                    <span class="text-ink-soft font-mono text-[10px] tracking-[0.15em] uppercase">
                      Work
                    </span>
                    {entry.work.map((w) => (
                      <a
                        href={w.href}
                        class="text-signal hover:underline font-mono text-xs"
                      >
                        {w.label}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-12">Get in touch</Button>
  </section>
</BaseLayout>
